{
  "name": "@voice-notes/cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:validation": "wrangler deploy --config wrangler.validation.jsonc",
    "test": "vitest run",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "check:bundle": "wrangler deploy --dry-run --outdir .bundle && wrangler deploy --dry-run --config wrangler.validation.jsonc --outdir .bundle/validation"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
